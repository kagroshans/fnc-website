          <article class="card" data-card>
            <div class="card__header" data-card-trigger>
              <div class="card__icon">
                {% if card.id == "buy-a-partial" %}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#001F3E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="6" r="3"/>
                  <circle cx="6" cy="18" r="3"/>
                  <line x1="20" y1="4" x2="8.12" y2="15.88"/>
                  <line x1="14.47" y1="14.48" x2="20" y2="20"/>
                  <line x1="8.12" y1="8.12" x2="12" y2="12"/>
                </svg>
                {% else %}
                {{ card.icon }}
                {% endif %}
              </div>
              <h3 class="card__title">{{ card.title }}</h3>
              <p class="card__short">{{ card.short }}</p>
              <button class="card__toggle" aria-expanded="false">
                Learn More <span class="card__arrow">&#9660;</span>
              </button>
            </div>
            <div class="card__body" hidden>
              {% for paragraph in card.body %}
              <p>{{ paragraph }}</p>
              {% endfor %}
              <a href="mailto:{{ site.email }}?subject={{ card.cta.subject }}" class="btn btn--primary card__cta">{{ card.cta.label }}</a>
            </div>
          </article>
