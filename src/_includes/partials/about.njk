    <!-- ===== ABOUT ===== -->
    <section class="about" id="about">
      <div class="section-inner">
        <div class="about__layout">

          <div class="about__photo-wrap">
            <img
              src="/{{ about.photo }}"
              alt="{{ about.photoAlt }}"
              class="about__photo"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="about__photo-placeholder" aria-hidden="true">{{ about.photoInitial }}</div>
          </div>

          <div class="about__bio">
            <h2 class="about__name">{{ about.name }}</h2>
            <p class="about__title">{{ about.title }}</p>
            <div class="about__text">
              {% for paragraph in about.paragraphs %}
              <p>{{ paragraph }}</p>
              {% endfor %}
            </div>
            <a href="{{ about.cta.href }}" class="btn btn--primary about__cta">{{ about.cta.label }}</a>
          </div>

        </div>
      </div>
    </section>
