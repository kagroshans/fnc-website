  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="footer__inner">
      <div class="footer__logo-block">
        <a href="/">
          <img src="/assets/logo-rectangle.png" alt="Freedom Note Capital" class="footer__logo" />
        </a>
      </div>

      <div class="footer__info">
        <p class="footer__entity">{{ site.entityName }}</p>
        <p class="footer__email">
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </p>
        <p class="footer__copyright">&copy; {{ site.copyrightYear }} {{ site.entityName }}. All rights reserved.</p>
      </div>

      <p class="footer__disclaimer">{{ site.disclaimer }}</p>
    </div>
  </footer>
