<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}" />

  <!-- Canonical -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.title }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ site.entityName }}" />
  {% if pageImage %}
  <meta property="og:image" content="{{ site.url }}{{ pageImage }}" />
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/logo-square.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/styles.css" />

  <!-- Organization structured data -->
  {% set organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.entityName,
    "url": site.url,
    "email": site.email,
    "logo": site.url + "/assets/logo-rectangle.png"
  } %}
  <script type="application/ld+json">{{ organizationSchema | dump | safe }}</script>
</head>
<body>

  {% include "partials/navbar.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/js/main.js"></script>
</body>
</html>
