---
layout: layouts/base.njk
ogType: article
eleventyComputed:
  pageImage: "{{ featuredImage }}"
---
    <article class="section-inner blog-post">
      <h1 class="section-heading">{{ title }}</h1>
      <p class="blog-post__meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% if author %} · {{ author }}{% endif %}
      </p>

      {% if featuredImage %}
      <img src="{{ featuredImage }}" alt="{{ featuredImageAlt or title }}" class="blog-post__image" />
      {% endif %}

      <div class="blog-post__content">
        {{ content | safe }}
      </div>

      {% set posts = collections.posts %}
      {% for post in posts %}
        {% if post.url == page.url %}
          {% set prevPost = posts[loop.index0 - 1] if not loop.first else null %}
          {% set nextPost = posts[loop.index0 + 1] if not loop.last else null %}
        {% endif %}
      {% endfor %}

      {% if prevPost or nextPost %}
      <nav class="blog-post__nav">
        {% if prevPost %}<a href="{{ prevPost.url }}" class="blog-post__prev">&larr; {{ prevPost.data.title }}</a>{% endif %}
        {% if nextPost %}<a href="{{ nextPost.url }}" class="blog-post__next">{{ nextPost.data.title }} &rarr;</a>{% endif %}
      </nav>
      {% endif %}

      {% set postImage = (site.url + featuredImage) if featuredImage else (site.url + "/assets/logo-rectangle.png") %}
      {% set postSchema = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "datePublished": date | htmlDateString,
        "image": postImage,
        "mainEntityOfPage": site.url + page.url,
        "author": { "@type": "Person", "name": author },
        "publisher": {
          "@type": "Organization",
          "name": site.entityName,
          "logo": { "@type": "ImageObject", "url": site.url + "/assets/logo-rectangle.png" }
        }
      } %}
      <script type="application/ld+json">{{ postSchema | dump | safe }}</script>
    </article>
